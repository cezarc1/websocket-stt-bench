---
# Checked by `bazel test //tools/lint:clang_format_test` (part of
# `just cpp-check`) with the hermetic LLVM 21.1.8 clang-format. Options were
# chosen to match the existing hand-formatted tree with minimal churn.
BasedOnStyle: LLVM
Language: Cpp
Standard: Latest
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
PointerAlignment: Left
AlwaysBreakTemplateDeclarations: Yes
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: true
IndentCaseLabels: true
SpacesBeforeTrailingComments: 2
PackConstructorInitializers: CurrentLine
BinPackParameters: true
BreakBeforeBraces: Attach
SpaceBeforeCpp11BracedList: false
# Preserve hand-grouped include blocks (doctest first in tests, then std,
# then third-party, then ours) instead of regrouping them.
IncludeBlocks: Preserve
